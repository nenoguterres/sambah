# SamBah CRM - exemplo de ambiente para integracao real Insano

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://insanofoodtruck.com.br
BASE_URL=https://api.insanofoodtruck.com.br
CORS_ORIGINS=https://insanofoodtruck.com.br,https://www.insanofoodtruck.com.br,https://api.insanofoodtruck.com.br,https://api.sambahcrm.com.br,http://localhost:3000,http://127.0.0.1:3000
WHATSAPP_NUMBER=5551980413745

# No Render, monte um Persistent Disk neste caminho para nao perder JSON em restart/deploy.
DATA_DIR=/var/data/sambah

# WhatsApp Business API - preencher somente quando for ativar o atendimento oficial.
WHATSAPP_PROVIDER=meta
WHATSAPP_SEND_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0

# IA e voz - nao preencher token real no repositorio.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

STT_PROVIDER=google
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_STT_LANGUAGE=pt-BR

TTS_PROVIDER=google
GOOGLE_TTS_LANGUAGE=pt-BR
GOOGLE_TTS_VOICE=

VOICE_REPLY_ENABLED=false
HUMAN_HANDOFF_ENABLED=true

# Mesa continua opcional e local por enquanto. Nao alterar sem necessidade operacional.
MESA_BASE_URL=http://127.0.0.1:4173
MESA_ORDER_PATH=/api/orders/external
MESA_MENU_PATH=/api/menu
MESA_HEALTH_PATH=/health
MESA_TIMEOUT_MS=1500

# Pedido estruturado vindo do site Insano/Wix
INSANO_WHATSAPP_NUMBER=
SITE_PUBLIC_TOKEN=
SITE_ORDERS_ENABLED=true

