{
  "name": "sambha-automacao-whats",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Painel/admin e auditoria operacional para automacao WhatsApp samBah!.",
  "scripts": {
    "start": "node src/server.js",
    "start:clean:3000": "powershell -ExecutionPolicy Bypass -File scripts/start-clean-3000.ps1",
    "start:prod": "set NODE_ENV=production&& node src/server.js",
    "test:prod": "set NODE_ENV=production&& node --test tests/*.test.js",
    "test": "node --test tests/*.test.js",
    "release:package": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
