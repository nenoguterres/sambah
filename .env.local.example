# SamBah - homologacao real da WhatsApp Cloud API
# Copie este arquivo para .env.local e preencha localmente.
# Nunca commite .env, .env.local ou qualquer token real.
# Nunca coloque token em codigo, docs, prints ou logs.

WHATSAPP_PROVIDER=meta
WHATSAPP_META_PHONE_NUMBER_ID=preencher_aqui
WHATSAPP_META_ACCESS_TOKEN=preencher_aqui
WHATSAPP_META_VERIFY_TOKEN=preencher_aqui
WHATSAPP_META_API_VERSION=v21.0

# Mesa protegido durante homologacao real da Meta.
# Nao aponte para o Mesa real nesta etapa.
MESA_BASE_URL=http://127.0.0.1:9
MESA_TIMEOUT_MS=250

# Configure na Meta uma URL publica/tunel apontando para:
# https://SEU-TUNEL-OU-STAGING/webhook/whatsapp
#
# O verify token configurado no painel da Meta deve ser igual a
# WHATSAPP_META_VERIFY_TOKEN neste arquivo local.
PEROLA_INSTAGRAM_ENABLED=false
PEROLA_INSTAGRAM_ACCESS_TOKEN=
PEROLA_INSTAGRAM_USER_ID=
PEROLA_INSTAGRAM_ACCOUNT=
PEROLA_INSTAGRAM_API_VERSION=v25.0
PEROLA_INSTAGRAM_API_BASE_URL=https://graph.instagram.com
